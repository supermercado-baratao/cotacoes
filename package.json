{
  "name": "cotacoes",
  "description": "Aplicação WEB para gerenciamento de cotações e controle de pedidos para supermercados.",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "emulators:start": "firebase emulators:start --only auth,firestore",
    "test": "vitest --passWithNoTests --run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prettier:check": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "type-check": "tsc -b --noEmit",
    "eslint:check": "eslint .",
    "eslint:fix": "eslint . --fix",
    "generate": "plop --plopfile generators/plopfile.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@hookform/resolvers": "7.0.5",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "@mui/x-data-grid": "9.17.0",
    "@react-pdf/renderer": "4.9.0",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-virtual": "3.14.26",
    "dayjs": "1.11.23",
    "firebase": "13.2.0",
    "imask": "7.6.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-imask": "7.6.1",
    "react-router": "8.5.1",
    "shiki": "4.6.0",
    "validation-br": "1.6.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@commitlint/cli": "20.5.3",
    "@eslint/js": "10.0.1",
    "@eslint/json": "2.1.1",
    "@eslint/markdown": "8.0.3",
    "@faker-js/faker": "10.6.0",
    "@playwright/test": "1.65.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/async-retry": "1.4.9",
    "@types/babel__core": "7.20.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "async-retry": "1.3.3",
    "babel-plugin-react-compiler": "1.0.0",
    "commitlint-config-emoji-convention": "1.0.3",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prefer-arrow-functions": "3.10.2",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-simple-import-sort": "13.0.0",
    "eslint-plugin-unicorn": "77.0.0",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "jsdom": "31.0.0",
    "lint-staged": "16.4.0",
    "plop": "4.0.5",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "24.x"
  }
}
