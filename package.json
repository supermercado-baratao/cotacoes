{
  "name": "cotacoes",
  "description": "Aplicação WEB para gerenciamento de cotações e controle de pedidos para supermercados.",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "emulators:start": "firebase emulators:start --only auth,firestore",
    "test": "vitest --no-file-parallelism --passWithNoTests --run",
    "test:watch": "vitest --no-file-parallelism",
    "prettier:check": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "eslint:check": "eslint .",
    "eslint:fix": "eslint . --fix",
    "generate": "plop --plopfile generators/plopfile.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@hookform/resolvers": "5.2.2",
    "@mui/icons-material": "9.0.0",
    "@mui/material": "9.0.0",
    "@mui/x-data-grid": "9.0.4",
    "@tanstack/react-query": "4.44.0",
    "dayjs": "1.11.20",
    "firebase": "12.12.1",
    "imask": "7.6.1",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-hook-form": "7.75.0",
    "react-imask": "7.6.1",
    "react-router": "7.14.2",
    "validation-br": "1.6.4",
    "xlsx": "0.18.5",
    "zod": "4.4.3",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@commitlint/cli": "20.5.3",
    "@eslint/js": "10.0.1",
    "@eslint/markdown": "8.0.1",
    "@faker-js/faker": "10.4.0",
    "@rolldown/plugin-babel": "0.2.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/async-retry": "1.4.9",
    "@types/babel__core": "7.20.5",
    "@types/node": "24.12.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "async-retry": "1.3.3",
    "babel-plugin-react-compiler": "1.0.0",
    "commitlint-config-emoji-convention": "1.0.3",
    "eslint": "10.2.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "eslint-plugin-simple-import-sort": "13.0.0",
    "globals": "17.5.0",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "16.4.0",
    "plop": "4.0.5",
    "prettier": "3.8.3",
    "typescript": "6.0.2",
    "typescript-eslint": "8.58.2",
    "vite": "8.0.10",
    "vitest": "4.1.5"
  }
}
