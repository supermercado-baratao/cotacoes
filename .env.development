# Local values only: in development the app always talks to the Firebase
# emulators, and the `demo-` project ID keeps them from reaching real resources
VITE_API_KEY=demo-api-key
VITE_AUTH_DOMAIN=localhost
VITE_PROJECT_ID=demo-cotacoes
VITE_APP_ID=demo-app-id
VITE_STORAGE_BUCKET=
VITE_MESSAGING_SENDER_ID=
VITE_APP_MEASUREMENT_ID=

# Outside production the AI suggestions come from the local fallback
VITE_GEMINI_MODEL=
VITE_GEMINI_API_KEY=
